# Configuracao OCI do SUS Radar 360.
# Copie para .claude/oci.env (que e gitignored) e preencha.
# NAO coloque segredo aqui — senha e token vao em .claude/oci.secrets (chmod 600).

OCI_BIN=.venv/bin/oci
OCI_PROFILE=DEFAULT

# Preencher a mao:
OCI_REGION=                     # ex: sa-saopaulo-1, sa-vinhedo-1, us-ashburn-1
OCI_COMPARTMENT_ID=             # ocid1.compartment.oc1..  (ou o OCID da tenancy)

# Descobrir depois de autenticar:
#   .venv/bin/oci os ns get --raw-output --query data
OCI_NAMESPACE=
OCI_TENANCY_ID=

# Object Storage
OCI_BUCKET_RAW=datasus-raw
OCI_BUCKET_STAGING=datasus-staging

# Autonomous Database (preencher depois de provisionar)
ADB_OCID=
ADB_NAME=SUSRADAR
ADB_WALLET_DIR=~/.oci/wallets/susradar
